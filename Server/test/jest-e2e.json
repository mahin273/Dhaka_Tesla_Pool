{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "allowJs": true,
          "esModuleInterop": true
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@nestjs/passport|@nestjs/jwt)/)"
  ],
  "testEnvironment": "node"
}
